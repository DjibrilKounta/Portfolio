<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio @ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Portfolio.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="icon" type="image/x-icon" href="~/img/logo.ico" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/img/logo.png" width="40px" style="margin-right: 20px;" alt="Portfolio Logo" class="img-fluid" />Portfolio</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Project" asp-action="Index">Projects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Resume">Resume</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="banner"
             style="background-image:url('/img/bg.png'); background-size:cover; background-position:center; height:500px;">

            <div class="h-100 d-flex flex-column justify-content-center align-items-center text-white text-center">

                <h1 class="display-2 fw-bold">@ViewData["HeaderTitle"]</h1>

                @if (ViewData["HeaderSubtitle"] != null)
                {
                    <h2 class="mt-3">@ViewData["HeaderSubtitle"]</h2>
                }

                @if (ViewData["HeaderText"] != null)
                {
                    <p class="lead mt-3 w-50">
                        @ViewData["HeaderText"]
                    </p>
                }

                @if (ViewData["HeaderButton"] != null)
                {
                    <a asp-controller="@ViewData["HeaderButtonController"]" asp-action="@ViewData["HeaderButtonAction"]"
                       class="btn btn-light mt-3">
                        @ViewData["HeaderButton"]
                    </a>
                }

            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="bg-light mt-5 py-4 mb-0">

        <div class="container">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">

                <p class="mb-0 text-center text-md-start">
                    © @DateTime.Now.Year Djibril Kounta
                </p>

                <div class="d-flex gap-4">

                    <a href="https://github.com/DjibrilKounta"
                       target="_blank"
                       class="text-decoration-none"
                       style="color:#181717;">
                        <i class="bi bi-github fs-3"></i>
                    </a>

                    <a href="https://linkedin.com/in/djibrilkounta"
                       target="_blank"
                       class="text-decoration-none"
                       style="color:#0A66C2;">
                        <i class="bi bi-linkedin fs-3"></i>
                    </a>

                    <a href="https://youtube.com/@@GameHooperStudio"
                       target="_blank"
                       class="text-decoration-none"
                       style="color:#FF0000;">
                        <i class="bi bi-youtube fs-3"></i>
                    </a>

                    <a href="https://discord.com/users/TON_ID"
                       target="_blank"
                       class="text-decoration-none"
                       style="color:#5865F2;">
                        <i class="bi bi-discord fs-3"></i>
                    </a>

                </div>

            </div>

        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
