<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
@{
    ViewData["HeaderTitle"] = "Djibril Kounta";
    ViewData["HeaderSubtitle"] = "Développeur Logiciel Full-Stack";
    ViewData["HeaderText"] = "C# • .NET • React • SQL Server";
    ViewData["HeaderButton"] = "Voir mes projets";
    ViewData["HeaderButtonController"] = "Project";
    ViewData["HeaderButtonAction"] = "Index";
}
<!-- ===================== À propos ===================== -->

<section class="container py-5">

    <div class="row align-items-center gy-5">

        <div class="col-12 col-lg-7">

            <h2 class="display-5 fw-bold text-primary mb-4">
                À propos de moi
            </h2>

            <p>
                Bonjour, je suis Djibril Kounta, développeur logiciel et Full-Stack basé à Montréal.
            </p>

            <p>
                Passionné par la création d'applications et la résolution de problèmes, je développe des solutions
                modernes avec C#, .NET, SQL Server, JavaScript, TypeScript et React.
            </p>

            <p>
                Actuellement étudiant en Techniques de l'informatique au Cégep du Vieux Montréal, je cherche
                constamment à approfondir mes compétences à travers des projets concrets en développement logiciel,
                web et jeux vidéo.
            </p>

            <p>
                Mon objectif est de concevoir des applications performantes, évolutives et utiles tout en explorant les
                nouvelles technologies, notamment l'intelligence artificielle et le développement Full-Stack.
            </p>

        </div>

        <div class="col-12 col-lg-5 text-center">
            <img src="~/img/profil.jpeg"
                 class="img-fluid rounded shadow"
                 alt="Photo de profil">
        </div>

    </div>

</section>

<!-- ===================== Compétences ===================== -->

<section class="bg-light py-5">

    <div class="container text-center">

        <h2 class="display-5 fw-bold text-primary mb-5">
            Compétences techniques
        </h2>

        <div class="row gy-5">

            <div class="col-12 col-md-4">

                <h3 class="text-primary fw-bold mb-4">Langages</h3>

                <ul class="d-inline-block text-start">
                    <li>C#</li>
                    <li>C++</li>
                    <li>JavaScript</li>
                    <li>TypeScript</li>
                    <li>SQL</li>
                    <li>HTML/CSS</li>
                </ul>

            </div>

            <div class="col-12 col-md-4">

                <h3 class="text-primary fw-bold mb-4">Technologies</h3>

                <ul class="d-inline-block text-start">
                    <li>.NET</li>
                    <li>ASP.NET MVC</li>
                    <li>WPF</li>
                    <li>React</li>
                    <li>Entity Framework</li>
                    <li>Bootstrap</li>
                    <li>Unity</li>
                </ul>

            </div>

            <div class="col-12 col-md-4">

                <h3 class="text-primary fw-bold mb-4">Outils</h3>

                <ul class="d-inline-block text-start">
                    <li>Git</li>
                    <li>GitHub</li>
                    <li>Visual Studio</li>
                    <li>VS Code</li>
                    <li>SQL Server</li>
                </ul>

            </div>

        </div>

    </div>

</section>

<!-- ===================== Projets ===================== -->

<section class="container py-5">

    <h2 class="display-5 fw-bold text-primary text-center mb-5">
        Projets récents
    </h2>

    <div class="row gy-4">

        <div class="col-12 col-md-6 col-xl-4">

            <div class="card h-100 shadow-sm">

                <img src="~/img/projects/diskmaster.png" class="card-img-top" alt="DiskMaster">

                <div class="card-body d-flex flex-column">

                    <h4 class="card-title text-primary fw-bold">
                        DiskMaster
                    </h4>

                    <p>
                        Application de maintenance système développée avec C#, .NET et WPF permettant :
                    </p>

                    <ul>
                        <li>Analyse du stockage</li>
                        <li>Nettoyage automatique</li>
                        <li>Gestion de l'espace disque</li>
                    </ul>

                    <a href="https://github.com/DjibrilKounta/DiskMaster" class="btn btn-primary mt-auto">
                        Voir le projet
                    </a>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-6 col-xl-4">

            <div class="card h-100 shadow-sm">

                <img src="..." class="card-img-top" alt="ADEBOG">

                <div class="card-body d-flex flex-column">

                    <h4 class="card-title text-primary fw-bold">
                        ADEBOG
                    </h4>

                    <p>
                        Application de gestion pour club de boxe développée avec C#, ASP.NET MVC permettant :
                    </p>

                    <ul>
                        <li>Gestion des membres</li>
                        <li>Inscriptions</li>
                        <li>Base de données SQL Server</li>
                    </ul>

                    <a href="#" class="btn btn-primary mt-auto">
                        Voir le projet
                    </a>

                </div>

            </div>

        </div>

        <div class="col-12 col-md-6 col-xl-4">

            <div class="card h-100 shadow-sm">

                <img src="..." class="card-img-top" alt="BattleShip">

                <div class="card-body d-flex flex-column">

                    <h4 class="card-title text-primary fw-bold">
                        BattleShip 3D
                    </h4>

                    <p>
                        Combat naval en 3D développé avec Unity permettant :
                    </p>

                    <ul>
                        <li>Déplacement des navires</li>
                        <li>Détection des tirs et collisions</li>
                        <li>Gestion des tours de jeu</li>
                    </ul>

                    <a href="#" class="btn btn-primary mt-auto">
                        Voir le projet
                    </a>

                </div>

            </div>

        </div>

    </div>

    <div class="text-center mt-5">

        <a asp-controller="Project" asp-action="Index" class="btn btn-primary btn-lg">
            Voir tous mes projets
        </a>

    </div>

</section>

<!-- ===================== Formations ===================== -->

<section class="bg-light py-5">

    <div class="container">

        <h2 class="display-5 fw-bold text-primary text-center mb-5">
            Formations
        </h2>

        <div class="row gy-5 text-center">

            <div class="col-12 col-md-6">

                <h3 class="text-primary fw-bold mb-3">
                    DEC Techniques de l'informatique
                </h3>

                <p class="mb-1">
                    Cégep du Vieux Montréal
                </p>

                <p>
                    2025 – Présent
                </p>

            </div>

            <div class="col-12 col-md-6">

                <h3 class="text-primary fw-bold mb-3">
                    Licence en Génie Informatique
                </h3>

                <p class="mb-1">
                    Université Libre de Guinée
                </p>

                <p>
                    2020 – 2024
                </p>

            </div>

        </div>

    </div>

</section>